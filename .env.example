# ==============================================================================
# Gerrit-It — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real credentials, access tokens, or private .env files to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
# Port for the Node.js Express server to listen on. Default: 3000
PORT=3000

# Environment mode: 'development', 'production', or 'test'. Default: development
NODE_ENV=development

# Host interface to bind: '0.0.0.0' for all interfaces, '127.0.0.1' for localhost only.
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Wikimedia Gerrit Upstream Service
# ------------------------------------------------------------------------------
# Base URL for the official Wikimedia Gerrit REST API. Default: https://gerrit.wikimedia.org/r
GERRIT_BASE_URL=https://gerrit.wikimedia.org/r

# Upstream request timeout in milliseconds. Default: 15000 (15 seconds)
GERRIT_TIMEOUT_MS=15000

# Changes per paginated batch request (Gerrit query 'n' param). Default: 100
GERRIT_PAGE_LIMIT=100

# Maximum page pagination safety budget to prevent gateway timeouts. Default: 20
GERRIT_MAX_PAGES=20

# Maximum concurrent requests dispatched to Gerrit upstream. Default: 5
GERRIT_MAX_CONCURRENCY=5

# ------------------------------------------------------------------------------
# Caching Configuration
# ------------------------------------------------------------------------------
# Redis connection URL (e.g. redis://localhost:6379 or redis://redis:6379).
# Optional: If empty or unreachable, automatically degrades to in-memory LRU cache.
REDIS_URL=

# Cache Time-To-Live (TTL) in seconds. Default: 14400 (4 hours)
CACHE_TTL_SECONDS=14400

# Maximum in-memory LRU items when running in fallback/local mode. Default: 1000
CACHE_MAX_MEMORY_ITEMS=1000

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
# Sliding window for API request rate limiting in milliseconds. Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per IP address allowed within the sliding window. Default: 120
RATE_LIMIT_MAX_REQUESTS=120

# Allowed CORS origin in development mode. In production, same-origin is enforced.
CORS_ORIGIN=http://localhost:5173
