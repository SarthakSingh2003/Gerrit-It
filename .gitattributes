# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.example text eol=lf

# Shell and script files
*.sh text eol=lf
Procfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
